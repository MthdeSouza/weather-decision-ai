rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userProfileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userRole(uid) {
      return userProfileExists(uid)
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : 'basic';
    }

    function isAdmin() {
      return isAuthenticated() && userRole(request.auth.uid) == 'admin';
    }

    function isApproverOrAdmin() {
      return isAuthenticated()
        && userRole(request.auth.uid) in ['approver', 'admin'];
    }

    function hasValidUserProfile(profile) {
      return profile.name is string
        && profile.name.size() <= 200
        && profile.email is string
        && profile.email.size() <= 320
        && profile.photoURL is string
        && profile.photoURL.size() <= 2048
        && profile.provider in ['google.com', 'firebase'];
    }

    function canReadTicket(ticket) {
      return isAuthenticated()
        && (ticket.createdBy.uid == request.auth.uid || isApproverOrAdmin());
    }

    match /users/{userId} {
      allow get: if isAuthenticated()
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'photoURL', 'provider', 'role',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'basic'
        && hasValidUserProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if isAdmin() || (
        isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && hasValidUserProfile(request.resource.data)
        && (
          ('role' in resource.data
            && request.resource.data.role == resource.data.role)
          || (!('role' in resource.data)
            && request.resource.data.role == 'basic')
        )
        && (
          ('createdAt' in resource.data
            && request.resource.data.createdAt == resource.data.createdAt)
          || (!('createdAt' in resource.data)
            && request.resource.data.createdAt == request.time)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'photoURL', 'provider', 'role', 'createdAt',
          'updatedAt', 'lastLoginAt'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastLoginAt == request.time
      );

      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow get, list: if canReadTicket(resource.data);

      // Ticket changes are made by authenticated Next.js Route Handlers using Admin SDK.
      allow update, delete: if false;
    }

    match /ticketCreationLocks/{uid} {
      allow read, write: if false;
    }

    match /apiRateLimits/{rateLimitId} {
      allow read, write: if false;
    }
  }
}
